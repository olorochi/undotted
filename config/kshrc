function dotnew {
  dotnet new console -o "$1" --no-restore=true
  cd "$1"
  dotnet new sln
  dotnet sln add "$1.csproj"
}

function dotnewl {
  dotnet new classlib -o "$1" --no-restore=true
  cd "$1"
  dotnet new sln
  dotnet sln add "$1.csproj"
}

function rec {
  perf record --call-graph dwarf,16384 -g -o perf.data $@
}

function recp {
  rec $@
  rep
}

function flame {
  perf script | stackcollapse-perf.pl | flamegraph.pl > flamegraph.svg
  librewolf flamegraph.svg
}

function recf {
  rec $1
  flame
}

function kiss-cd {
  cd $(k s $1 | head -n 1)
}

function kiss-adddep {
  printf '%s\n' $@ >> depends
  sort depends -o depends
}

function kiss-remdep {
  grep -v ^cbindgen[\ $] depends > depends_remdep_tmp
  mv depends{_remdep_tmp,}
}

