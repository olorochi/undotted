#! /bin/ksh

jobstats() {
  rc=$?
  out=$(
    jobs -l 2>/dev/null |
    awk '
    BEGIN { active=inactive=0; current="-" }

    /^\[/ {
      job=$1
      sub(/^\[/, "", job)
      sub(/\].*/, "", job)

      if ($2 == "+")
        current=job

      state=""
      for (i=1; i<=NF; i++) {
        if ($i == "Running" || $i == "Stopped" ||
            $i == "Done" || $i == "Terminated" ||
            $i == "Killed") {
          state=$i
          break
        }
      }

      if (state == "Running")
        active++
      else
        inactive++
    }

    END {
      if (active + inactive > 0)
        print active ":" inactive ":" current
    }'
  )

  if [ "$rc" -eq 0 ]; then
    print "$e\033[32m$e${out:+$out:}$rc$e\033[0m$e"
  else
    print "$e\033[31m$e${out:+$out:}$rc$e\033[0m$e"
  fi

  return "$rc"
}

osc7() {
  local tmp="$PWD"
  local enc
  while [ -n "$tmp" ]; do
    local cut="${tmp#?}"
    local c="${tmp%"$cut"}"
    case "$c" in
      [-/:_.!\'\(\)~[:alnum:]] ) enc="$enc$c" ;;
      * ) enc="$enc$(printf '%%%02X' """\"$c")"  ;;
    esac
    tmp="$cut"
  done

  printf "\033]7;file://%s%s\033\\" "$HOSTNAME" "$enc"
}

