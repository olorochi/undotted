vim9s

def g:LibCall(lib: string, fn: string, arg: string): string
    return libcall($MYVIMDIR .. "lib/" .. lib, fn, arg)
enddef
def g:LibCallNr(lib: string, fn: string, arg: string): number
    return libcallnr($MYVIMDIR .. "lib/" .. lib, fn, arg)
enddef

def g:FileInfo(): string
    if (&buftype != "")
        return ""
    endif
    return g:LibCall('FSLib.so', 'fileInfo', expand('%'))
enddef

def g:Warn(mes: string)
    echoh WarningMsg | echom mes | echoh None
enddef

def g:Script(script: string)
    const root = fnamemodify(finddir(".vim", getcwd() .. ";"), ":h")
    const bufpath = script .. "://" .. fnamemodify(root, ":p")
    var buf = bufnr(bufpath)

    if buf == -1
        buf = bufadd(bufpath)
        bufload(buf)
    endif

    setbufvar(buf, "&buftype", "nofile")
    setbufvar(buf, "&bufhidden", "hide")
    setbufvar(buf, "&swapfile", false)
    deletebufline(buf, 1, "$")

    var cmd = root .. "/.vim/" .. script .. " " .. shellescape(expand("%:p"))

    job_start(cmd, {
        "cwd": root,
        "out_io": "buffer",
        "out_buf": buf,
        "err_io": "buffer",
        "err_buf": buf,
        "exit_cb": (_, status) => {
            echom "Child exited with [" .. status .. "]."
        }
    })

    if empty(win_findbuf(buf))
        execute "sbuffer " .. buf
    endif
enddef

augroup ProjectCwd
    autocmd!
    autocmd BufEnter * call s:ProjectCwd()
augroup END

def ProjectCwd()
    if &buftype == "nofile"
        return
    endif
    if &filetype == "netrw"
        execute "cd " .. fnameescape(expand("%"))
        return
    endif

    var dir = expand("%:h")
    execute "cd " .. fnameescape(dir)
enddef

au BufEnter * call CleanBufs()
def g:CleanBufs()
    var bufs = filter(getbufinfo({"buflisted": true}), (_, v) => !v.changed && v.hidden)
    for buf in bufs
        exe "bd " .. buf.bufnr
    endfor
enddef

def g:LspSetup()
    g:LspOptionsSet({
            # autoComplete: v:false,
            autoHighlight: v:true,
            completionMatcher: 'fuzzy',
            completionMatcherValue: 1,
            echoSignature: v:true,
            diagSignErrorText: 'E',
            diagSignHintText: 'H',
            diagSignInfoText: 'I',
            diagSignWarningText: 'W',
            hideDisabledCodeActions: v:false,
            hoverInPreview: v:false,
            diagVirtualTextAlign: 'after',
            diagVirtualTextWrap: 'truncate',
            noNewlineInCompletion: v:false,
            # omniComplete: v:true,
            # omniCompleteAllowBare: v:true,
            outlineOnRight: v:true,
            outlineWinSize: 30,
            popupBorder: v:true,
            popupBorderHighlight: 'Title',
            popupHighlight: 'Normal',
            semanticHighlight: v:true,
            showDiagInPopup: v:false,
            showDiagWithVirtualText: v:true,
            showDiagWithSign: v:false,
            showInlayHints: v:false,
            showSignature: v:true,
            snippetSupport: v:false,
            useBufferCompletion: v:true,
            usePopupInCodeAction: v:false,
            useQuickfixForLocations: v:true,
            filterCompletionDuplicates: v:true,
            condensedCompletionMenu: v:true,
        })

    g:LspAddServer([{
        name: 'clang',
        filetype: ['c', 'cpp'],
        path: 'clangd',
        args: [ "--background-index", "--clang-tidy", "--completion-style=bundled", "--header-insertion=never", "--header-insertion-decorators", "--limit-references=0", "--limit-results=0", "--rename-file-limit=0" ]
    },
    {
        name: 'zls',
        filetype: 'zig',
        path: 'zls'
    },
    {
        name: 'pylsp',
        filetype: 'python',
        path: 'pylsp'
    },
    {
        name: 'ts-ls',
        filetype: ['typescript', 'javascript'],
        path: 'typescript-language-server',
        args: ['--stdio']
    },
    # {
    #     name: 'csharp-ls',
    #     filetype: 'cs',
    #     path: 'csharp-ls'
    # }
    ])

    no <silent>gln :LspRename<cr>
    no <silent>gla :LspCodeAction<cr>
    no <silent>gls :LspDocumentSymbol<cr>
    no <silent>glS :LspSymbolSearch<cr>
    no <silent>glD :LspGotoDeclaration<cr>
    no <silent>gld :LspGotoDefinition<cr>
    no <silent>glt :LspGotoTypeDef<cr>
    no <silent>gli :LspGotoImpl<cr>
    no <silent>glr :LspShowReferences<cr>
    no <silent>glh :LspInlayHints<cr>
    no <silent>glk :LspIncomingCalls<cr>
    no <silent>glj :LspOutgoingCalls<cr>
    no <silent>glJ :LspSubTypeHierarchy<cr>
    no <silent>glK :LspSuperTypeHierarchy<cr>
    nno <silent><c-space> :LspSelectionExpand<cr>
    nno <silent><c-s-space> :LspSelectionShrink<cr>
    xno <silent><c-space> :<bs><bs><bs><bs><bs>LspSelectionExpand<cr>
    xno <silent><c-s-space> :<bs><bs><bs><bs><bs>LspSelectionShrink<cr>
    no <silent><leader>xx :LspDiag current<cr>
    no <silent><leader>xl :LspDiag show<cr>
    no <silent>]x :LspDiag next<cr>
    no <silent>[x :LspDiag prev<cr>
    no <silent>]X :LspDiag last<cr>
    no <silent>[X :LspDiag first<cr>
    no <silent>+ :LspFormat<cr>
    # for some reason LspComplete(v:true) bricks zls and perhaps every lsp
    # until restart.
    # ino <C-space> <C-\><C-o>:call lsp#completion#LspComplete(v:true)<cr>

    aug LspMapOverrides
        au User LspAttached {
                no <buffer><silent>gO :LspOutline<cr>
                no <buffer><silent>K :LspHover<cr>
                no <buffer><silent><c-^> :LspSwitchSourceHeader<cr>
            }
    aug END

    aug HoldHl
        au CursorHold,CursorHoldI * sil! LspHighlight
        au CursorMoved,CursorMovedI * sil! LspHighlightClear
    aug END
enddef

